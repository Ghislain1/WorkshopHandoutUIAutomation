<Window x:Class="CustomerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomerApp"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:CustomerApp.Models"
        xmlns:vm="clr-namespace:CustomerApp.ViewModels"           
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="Kundenverwaltung"
        Height="600"
        Width="900"
        AutomationProperties.AutomationId="MainWindow">
 <Window.Resources>
  <ObjectDataProvider x:Key="CustomerStatuses"
                        MethodName="GetValues"
                        ObjectType="{x:Type sys:Enum}">
   <ObjectDataProvider.MethodParameters>
    <x:Type TypeName="models:CustomerStatus" />
   </ObjectDataProvider.MethodParameters>
  </ObjectDataProvider>
 </Window.Resources>

 <DockPanel Margin="16">

   <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">

    <Button Content="Kunde hinzufügen"
                    AutomationProperties.AutomationId="AddCustomerButton"
                    Command="{Binding AddCustomerCommand}"
                    Margin="0,0,8,0" />

    <Button Content="Kunde löschen"
                    AutomationProperties.AutomationId="DeleteCustomerButton"
                    Command="{Binding DeleteCustomerCommand}"
                    Margin="0,0,8,0" />

    <Button Content="Speichern"
                    AutomationProperties.AutomationId="SaveCustomersButton"
                    Command="{Binding SaveCustomersCommand}" />

    <TextBlock Text="Suche:"
                    VerticalAlignment="Center"
                    Margin="16,0,4,0" />

    <TextBox Width="220"
                    VerticalContentAlignment="Center"
                    AutomationProperties.AutomationId="SearchBox"
                    AutomationProperties.Name="Suche"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
   </StackPanel>

   <TextBlock DockPanel.Dock="Bottom"
                  Margin="0,12,0,0"
                  AutomationProperties.AutomationId="StatusMessage"
                  Text="{Binding StatusMessage}" />

   <DataGrid AutomationProperties.AutomationId="CustomerDataGrid"
                  ItemsSource="{Binding FilteredCustomers}"
                  SelectedItem="{Binding SelectedCustomer,
                                 Mode=TwoWay,
                                 UpdateSourceTrigger=PropertyChanged}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single">

   <DataGrid.Columns>

    <!-- Text -->
    <DataGridTextColumn Header="Name"
                            AutomationProperties.AutomationId="NameColumn"
                            Binding="{Binding Name,
                                      UpdateSourceTrigger=PropertyChanged}"
                            Width="150" />

    <!-- Text / E-Mail -->
    <DataGridTextColumn Header="E-Mail"
                            AutomationProperties.AutomationId="EmailColumn"
                            Binding="{Binding Email,
                                      UpdateSourceTrigger=PropertyChanged}"
                            Width="200" />

    <!-- Boolean -->
    <DataGridCheckBoxColumn Header="Aktiv"
                                AutomationProperties.AutomationId="IsActiveColumn"
                                Binding="{Binding IsActive,
                                          UpdateSourceTrigger=PropertyChanged}"
                                IsThreeState="False" />

    <!-- Enum -->
    <DataGridComboBoxColumn Header="Status"
                                AutomationProperties.AutomationId="StatusColumn"
                                SelectedItemBinding="{Binding Status}"
                                ItemsSource="{Binding Source={StaticResource CustomerStatuses}}" />

    <!-- Uri -->
    <DataGridHyperlinkColumn Header="Website"
                                 AutomationProperties.AutomationId="WebsiteColumn"
                                 Binding="{Binding Website}"
                                 ContentBinding="{Binding Website}"
                                 Width="200" />

    <!-- Custom: DatePicker -->
    <DataGridTemplateColumn Header="Geburtsdatum"
                                AutomationProperties.AutomationId="BirthDateColumn">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <TextBlock Text="{Binding BirthDate,
                                      StringFormat=d}"
                               VerticalAlignment="Center"
                               Margin="4,0" />
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>

     <DataGridTemplateColumn.CellEditingTemplate>
      <DataTemplate>
       <DatePicker AutomationProperties.AutomationId="BirthDatePicker"
                                SelectedDate="{Binding BirthDate,
                                               UpdateSourceTrigger=PropertyChanged}" />
      </DataTemplate>
     </DataGridTemplateColumn.CellEditingTemplate>
    </DataGridTemplateColumn>

    <!-- Custom: Aktion -->
    <DataGridTemplateColumn Header="Aktion"
                                AutomationProperties.AutomationId="ActionsColumn">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <Button Content="Details"
                            AutomationProperties.AutomationId="CustomerDetailsButton"
                            Command="{Binding DataContext.ShowDetailsCommand,
                                      RelativeSource={RelativeSource
                                          AncestorType=Window}}"
                            CommandParameter="{Binding}" />
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>

   </DataGrid.Columns>
  </DataGrid>
  </DockPanel>
</Window>
